from Crypto.Cipher import DES
from Crypto.Util.Padding import pad, unpad

key = input("Enter 8 character key: ").encode()
text = input("Enter plaintext: ").encode()

cipher = DES.new(key, DES.MODE_ECB)

encrypted = cipher.encrypt(pad(text, DES.block_size))
print("Encrypted text:", encrypted.hex())

decrypted = cipher.decrypt(encrypted)
print("Decrypted text:", unpad(decrypted, DES.block_size).decode())
