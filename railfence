text = input("Enter the text: ").upper()
rail1 = ""
rail2 = ""
for i in range(len(text)):
    if i % 2 == 0:
        rail1 += text[i]
    else:
        rail2 += text[i]
cipher = rail1 + rail2
print("Encrypted Text:", cipher)
mid = (len(cipher) + 1) // 2
rail1 = cipher[:mid]
rail2 = cipher[mid:]
plain = ""
i = 0
j = 0
for k in range(len(cipher)):
    if k % 2 == 0:
        plain += rail1[i]
        i += 1
    else:
        plain += rail2[j]
        j += 1
print("Decrypted Text:", plain)
